    "test:historical-replay-local": "vitest run test/local"
  },
  "dependencies": {
    "@trade/contracts": "*",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
