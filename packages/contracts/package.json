{
  "name": "@trade/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./src/schemas/*"
  },
  "scripts": {
    "generate": "tsx scripts/generate-types.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "decimal.js": "^10.5.0"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  }
}
