{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading.system/schemas/events/post-trade-audit-report.json",
  "title": "PostTradeAuditReportPayload",
  "description": "Read-only comparison report produced outside the live path.",
  "type": "object",
  "required": [
    "candidate_id",
    "execution_report_id",
    "observations",
    "comparisons",
    "reported_at"
  ],
  "additionalProperties": false,
  "properties": {
    "candidate_id": { "$ref": "../primitives.json#/$defs/UUIDv7" },
    "execution_report_id": { "$ref": "../primitives.json#/$defs/UUIDv7" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "comparisons": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "reported_at": { "$ref": "../primitives.json#/$defs/TimestampISO" }
  }
}
