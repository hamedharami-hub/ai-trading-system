{
  "name": "ai-trading-system",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@trade/pwa",
    "build": "turbo run build",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify:offline-ai": "npm test --workspace=@trade/offline-ai && npm run build --workspace=@trade/pwa",
    "verify:offline-replay": "npm test --workspace=@trade/deterministic-core && npm run build --workspace=@trade/pwa",
    "verify:offline": "npm test --workspace=@trade/offline-ai && npm test --workspace=@trade/deterministic-core && npm run build --workspace=@trade/pwa"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.6.2",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}