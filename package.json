{
  "name": "ai-trading-system",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify:offline-ai": "pnpm --filter @trade/offline-ai test && pnpm --filter @trade/pwa build",
    "verify:offline-replay": "pnpm --filter @trade/deterministic-core test && pnpm --filter @trade/pwa build",
    "verify:offline": "pnpm --filter @trade/offline-ai test && pnpm --filter @trade/deterministic-core test && pnpm --filter @trade/pwa build"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.6.2",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
