# Safe local configuration only. Do not add credentials or account data.
APP_ENV=development
LOG_LEVEL=info
LOCAL_NODE_HOST=127.0.0.1
LOCAL_NODE_PORT=4317

# External capabilities are intentionally disabled in the foundation.
LIVE_TRADING_ENABLED=false
BROKER_CONNECTORS_ENABLED=false
AI_ROUTER_ENABLED=false
MODEL_DOWNLOADS_ENABLED=false
