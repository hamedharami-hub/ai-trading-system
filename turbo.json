{
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint", "generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test", "generate"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate"],
      "outputs": []
    }
  }
}
